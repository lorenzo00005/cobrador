# --- Wallet del agente (Celo mainnet). NUNCA commitear la clave real. ---
AGENT_PRIVATE_KEY=0x...
CELO_RPC_URL=https://forno.celo.org
# Adaptador USDT para pagar gas en stablecoin (opcional). Si no, la wallet necesita algo de CELO.
# FEE_CURRENCY=0x0e2a3e05bc9a16f5292a6170456a710cb89c6f72

# --- Hackathon: tag de atribución ERC-8021 (te lo da Loops House al inscribirte). Obligatorio. ---
ATTRIBUTION_CODE=
# ALLOW_UNTAGGED=1   # SOLO para pruebas locales

# --- Destino final de los USD₮ (se puede cambiar por Telegram) ---
DESTINATION_WALLET=0x...

# --- Ripio Ramps API (docs.ripio.com/ramps-api). Si están las 3 primeras, el bot cobra por CVU propio. ---
RIPIO_CLIENT_ID=
RIPIO_CLIENT_SECRET=
RIPIO_CUSTOMER_ID=           # UUID del vendedor como customer de Ripio (KYC aprobado + T&C aceptados)
RIPIO_ENV=sandbox            # sandbox | production
RIPIO_WEBHOOK_SECRET=        # opcional: secreto del webhook /webhooks/ripio (lo da Ripio). Sin él, polling cada minuto
# RIPIO_CHAIN=               # default: ETHEREUM_SEPOLIA en sandbox (única red disponible), CELO en producción
# RIPIO_CURRENCY=            # default: RTEST en sandbox, WARS en producción (confirmar con /api/v1/depositNetworks/)

# --- Ripio on-ramp por link (ramp.ripio.com, sin credenciales). Se usa si no está la API. ---
# RAMP_COUNTRY=AR
# RAMP_CHAIN=celo
# RAMP_TOKEN=wARS
# DEPOSITS_FROM_BLOCK=        # opcional: escanear depósitos desde este bloque (por defecto, desde el arranque)

# --- Textile FX (opcional: sin API key firma una prueba de control con la wallet) ---
TEXTILE_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
OWNER_TELEGRAM_CHAT_ID=      # tu chat id: solo vos podés hablarle al agente

# --- Límites ---
MAX_SWAP_WARS=500000         # tope por liquidación, en wARS
# STATE_FILE=.data/state.json

# --- Modelo (AI Gateway de Vercel) ---
AI_GATEWAY_API_KEY=

# --- Gemini directo (free tier de Google AI Studio). Si está, reemplaza a AI Gateway. ---
GOOGLE_GENERATIVE_AI_API_KEY=

